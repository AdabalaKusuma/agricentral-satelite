# Copy to .env for local work. In production set these as container environment variables.

# ── Databases ───────────────────────────────────────────────────────────────────────────
# AgriCentral keeps these in TWO databases on the same host, so there are two connections.
# Nothing is joined across them: the worker reads geometry, does its maths, writes values.
#
# A .NET-style connection string converts like this:
#   Host=h;Database=d;Username=u;Password=p
#   -> postgresql+psycopg://u:p@h:5432/d        ('@' in a password must be written %40)

# Where the three Satellite* tables live: AgriCentral's DefaultConnection (farmfuture).
# That is the database with EF migration history, so that is where the migration puts them.
# The tables are created by `dotnet ef database update` - this worker never issues DDL.
DATABASE_URL=postgresql+psycopg://user:pass@10.110.0.144:5432/farmfuture

# Where farm geometry lives: AgriCentral's BackofficeConnection (farmfuture_backoffice), which
# holds "MapandCoordinates" and "Coordinate". READ ONLY - the worker never writes here.
# Set this to the same value as DATABASE_URL if both ever end up in one database.
GEOMETRY_DATABASE_URL=postgresql+psycopg://user:pass@10.110.0.144:5432/farmfuture_backoffice

# ── Schedule ────────────────────────────────────────────────────────────────────────────
# How often to sweep every farm, in minutes. Sentinel-2 revisits in about five days, so
# six hours is four catalog checks a day - enough to catch a new scene the morning it
# lands, and nearly free when there is none.
REFRESH_INTERVAL_MIN=360

# How often to pick up work the .NET API has queued (new farm, changed boundary).
QUEUE_POLL_SECONDS=30

# ── Resources ───────────────────────────────────────────────────────────────────────────
# Farms processed at once. Each holds its rasters in memory while it works, so this is the
# main lever on peak memory. Raise only after measuring with: python run.py --farm <uuid>
FARM_CONCURRENCY=1

# Skip the raster download when the newest catalog scene is the one already stored.
# Set false only to force a rebuild after changing how values are derived.
SKIP_UNCHANGED_SCENES=true

LOG_LEVEL=INFO
SQL_ECHO=false

# Refuse a farm whose BOUNDING BOX exceeds this many 20 m cells. Cost scales with the box,
# not the mapped area, so one stray coordinate can make a small farm span hundreds of km.
# 2,000,000 cells is roughly 800 km2 - far beyond any real estate.
MAX_CELLS=2000000
